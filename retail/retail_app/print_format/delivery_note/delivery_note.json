{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-07-22 17:24:40.287597",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Delivery Note",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 10mm 12mm 12mm 12mm;\r\n    }\r\n\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    body,\r\n    .print-format {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        font-size: 10px;\r\n        color: #333;\r\n        line-height: 1.35;\r\n    }\r\n\r\n    .delivery-note-container {\r\n        width: 100%;\r\n        min-height: 270mm;\r\n        position: relative;\r\n    }\r\n\r\n    /* ==================================================\r\n       LETTERHEAD \u2014 OLD IMAGE METHOD\r\n       Kept commented for future use\r\n       ================================================== */\r\n\r\n    /*.letterhead-table {*/\r\n    /*    width: 100%;*/\r\n    /*    border-collapse: collapse;*/\r\n    /*    margin-bottom: 10px;*/\r\n    /*}*/\r\n\r\n    /*.letterhead-table td {*/\r\n    /*    border: none !important;*/\r\n    /*    padding: 0;*/\r\n    /*    vertical-align: top;*/\r\n    /*}*/\r\n\r\n    /*.logo-cell {*/\r\n    /*    width: 50%;*/\r\n    /*    text-align: left;*/\r\n    /*}*/\r\n\r\n    /*.address-cell {*/\r\n    /*    width: 50%;*/\r\n    /*    text-align: right;*/\r\n    /*}*/\r\n\r\n    /*.logo-image {*/\r\n    /*    width: 285px;*/\r\n    /*    max-height: 85px;*/\r\n    /*    object-fit: contain;*/\r\n    /*    object-position: left top;*/\r\n    /*}*/\r\n\r\n    /*.address-image {*/\r\n    /*    width: 260px;*/\r\n    /*    max-height: 90px;*/\r\n    /*    object-fit: contain;*/\r\n    /*    object-position: right top;*/\r\n    /*}*/\r\n\r\n\r\n    /* ==================================================\r\n       DOCUMENT TITLE\r\n       ================================================== */\r\n\r\n    .document-heading-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin: 8px 0 22px;\r\n    }\r\n\r\n    .document-heading-table td {\r\n        border: none !important;\r\n        padding: 0;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .heading-empty-space {\r\n        width: 55%;\r\n    }\r\n\r\n    .heading-section {\r\n        width: 45%;\r\n        text-align: right;\r\n        padding-top: 5px !important;\r\n    }\r\n\r\n    .document-title {\r\n        margin: 0;\r\n        font-size: 26px;\r\n        line-height: 1.1;\r\n        font-weight: 500;\r\n        color: #222;\r\n    }\r\n\r\n    .document-number {\r\n        margin-top: 3px;\r\n        font-size: 9px;\r\n        font-weight: bold;\r\n        color: #444;\r\n    }\r\n\r\n\r\n    /* ==================================================\r\n       CUSTOMER AND DELIVERY INFORMATION\r\n       ================================================== */\r\n\r\n    .information-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 16px;\r\n    }\r\n\r\n    .information-table td {\r\n        border: none !important;\r\n        vertical-align: top;\r\n        padding: 0;\r\n    }\r\n\r\n    .customer-section {\r\n        width: 55%;\r\n        padding-top: 10px !important;\r\n        padding-right: 25px !important;\r\n    }\r\n\r\n    .delivery-info-section {\r\n        width: 45%;\r\n    }\r\n\r\n    .section-label {\r\n        color: #555;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .customer-name {\r\n        font-size: 11px;\r\n        font-weight: bold;\r\n        color: #333;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .customer-address {\r\n        font-size: 9.5px;\r\n        line-height: 1.4;\r\n        color: #444;\r\n    }\r\n\r\n    .contact-details {\r\n        margin-top: 4px;\r\n        font-size: 9px;\r\n        color: #444;\r\n    }\r\n\r\n    .delivery-details {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .delivery-details td {\r\n        border: none !important;\r\n        padding: 3px 5px;\r\n        height: 23px;\r\n    }\r\n\r\n    .delivery-details .detail-label {\r\n        width: 48%;\r\n        font-weight: bold;\r\n        color: #444;\r\n    }\r\n\r\n    .delivery-details .detail-value {\r\n        width: 52%;\r\n        text-align: right;\r\n        color: #222;\r\n    }\r\n\r\n\r\n    /* ==================================================\r\n       ITEM TABLE\r\n       ================================================== */\r\n\r\n    .item-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .item-table thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    .item-table th {\r\n        background: #333;\r\n        color: white;\r\n        border: none;\r\n        padding: 7px 6px;\r\n        font-weight: normal;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .item-table td {\r\n        padding: 8px 6px;\r\n        vertical-align: top;\r\n        border-left: none;\r\n        border-right: none;\r\n        border-top: none;\r\n        border-bottom: 1px solid #e0e0e0;\r\n        font-size: 9.5px;\r\n    }\r\n\r\n    .item-table tbody tr:last-child td {\r\n        border-bottom: none;\r\n        padding-bottom: 12px;\r\n    }\r\n\r\n    .col-number {\r\n        width: 7%;\r\n        text-align: center;\r\n    }\r\n\r\n    .col-image {\r\n        width: 13%;\r\n        text-align: center;\r\n    }\r\n\r\n    .col-description {\r\n        width: 65%;\r\n        text-align: left;\r\n    }\r\n\r\n    .col-qty {\r\n        width: 15%;\r\n        text-align: right;\r\n    }\r\n\r\n    .item-image {\r\n        width: 55px;\r\n        height: 55px;\r\n        max-width: 55px;\r\n        max-height: 55px;\r\n        object-fit: contain;\r\n    }\r\n\r\n    .item-image-placeholder {\r\n        width: 50px;\r\n        height: 50px;\r\n        margin: auto;\r\n        border: 1px solid #ddd;\r\n        color: #aaa;\r\n        font-size: 7px;\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n    }\r\n\r\n    .item-name {\r\n        font-size: 10px;\r\n        font-weight: 600;\r\n        color: #222;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .item-code {\r\n        color: #555;\r\n        font-size: 8.5px;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .item-description {\r\n        color: #555;\r\n        line-height: 1.4;\r\n        word-break: break-word;\r\n    }\r\n\r\n    .item-reference {\r\n        color: #555;\r\n        font-size: 8.5px;\r\n        line-height: 1.4;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .quantity-value {\r\n        font-size: 10px;\r\n        color: #222;\r\n    }\r\n\r\n    .quantity-uom {\r\n        font-size: 8px;\r\n        color: #555;\r\n        margin-top: 2px;\r\n    }\r\n\r\n\r\n    /* ==================================================\r\n       ITEM COUNT\r\n       ================================================== */\r\n\r\n    .item-count {\r\n        margin-top: 5px;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        color: #333;\r\n    }\r\n\r\n\r\n    /* ==================================================\r\n       DELIVERY REMARKS\r\n       ================================================== */\r\n\r\n    .remarks-section {\r\n        margin-top: 18px;\r\n        font-size: 9px;\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    .remarks-title {\r\n        font-weight: bold;\r\n        color: #555;\r\n        margin-bottom: 3px;\r\n    }\r\n\r\n    .remarks-content {\r\n        color: #444;\r\n        line-height: 1.45;\r\n    }\r\n\r\n\r\n    /* ==================================================\r\n       SIGNATURE SECTION\r\n       ================================================== */\r\n\r\n    .signature-section {\r\n        width: 100%;\r\n        margin-top: 65px;\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    .signature-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .signature-table td {\r\n        width: 33.33%;\r\n        border: none !important;\r\n        padding: 0 20px 0 0;\r\n        vertical-align: top;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .signature-field {\r\n        margin-bottom: 35px;\r\n    }\r\n\r\n    .signature-label {\r\n        font-weight: bold;\r\n        color: #444;\r\n    }\r\n\r\n    .signature-line {\r\n        display: inline-block;\r\n        width: 115px;\r\n        margin-left: 5px;\r\n        border-bottom: 1px solid #777;\r\n    }\r\n\r\n    .company-stamp-cell {\r\n        text-align: center;\r\n    }\r\n\r\n    .stamp-image {\r\n        max-width: 120px;\r\n        max-height: 120px;\r\n        object-fit: contain;\r\n    }\r\n\r\n    .stamp-label {\r\n        margin-top: 75px;\r\n        color: #555;\r\n        font-size: 9px;\r\n    }\r\n\r\n\r\n    /* ==================================================\r\n       PAGE BREAKING\r\n       ================================================== */\r\n\r\n    .item-table tr {\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    .information-table,\r\n    .remarks-section,\r\n    .signature-section {\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    @media print {\r\n        body,\r\n        .print-format {\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n\r\n        .delivery-note-container {\r\n            width: 100%;\r\n        }\r\n    }\r\n</style>\r\n\r\n\r\n<div class=\"delivery-note-container\">\r\n\r\n    <!-- ==================================================\r\n         LETTERHEAD \u2014 OLD IMAGE METHOD\r\n         Commented, not removed\r\n         ================================================== -->\r\n\r\n    <!--\r\n    <table class=\"letterhead-table\">\r\n        <tr>\r\n            <td class=\"logo-cell\">\r\n                <img\r\n                    src=\"/private/files/arabscale_logo.png\"\r\n                    class=\"logo-image\"\r\n                    alt=\"Arab Scale Trading\"\r\n                >\r\n            </td>\r\n\r\n            <td class=\"address-cell\">\r\n                <img\r\n                    src=\"/private/files/arabscale_address.png\"\r\n                    class=\"address-image\"\r\n                    alt=\"Company Address\"\r\n                >\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    -->\r\n\r\n\r\n    <!-- ==================================================\r\n         ACTIVE FIXED LETTERHEAD\r\n         Same method used in Sales Invoice\r\n         ================================================== -->\r\n\r\n    {% set fixed_letterhead = frappe.db.get_value(\r\n        \"Letter Head\",\r\n        \"Arab Scale Letter Head - Standard\",\r\n        \"content\"\r\n    ) %}\r\n\r\n    {% if fixed_letterhead %}\r\n        <div class=\"hardcoded-letterhead\">\r\n            {{ fixed_letterhead }}\r\n        </div>\r\n    {% endif %}\r\n\r\n\r\n    <!-- ==================================================\r\n         DOCUMENT TITLE\r\n         ================================================== -->\r\n\r\n    <table class=\"document-heading-table\">\r\n        <tr>\r\n            <td class=\"heading-empty-space\"></td>\r\n\r\n            <td class=\"heading-section\">\r\n                <h1 class=\"document-title\">\r\n                    DELIVERY NOTE\r\n                </h1>\r\n\r\n                <div class=\"document-number\">\r\n                    Delivery Note# {{ doc.name }}\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n\r\n    <!-- ==================================================\r\n         CUSTOMER AND DELIVERY INFORMATION\r\n         ================================================== -->\r\n\r\n    <table class=\"information-table\">\r\n        <tr>\r\n            <td class=\"customer-section\">\r\n\r\n                <div class=\"section-label\">\r\n                    Deliver To\r\n                </div>\r\n\r\n                <div class=\"customer-name\">\r\n                    {{ doc.customer_name or doc.customer }}\r\n                </div>\r\n\r\n                <div class=\"customer-address\">\r\n                    {% if doc.shipping_address %}\r\n                        {{ doc.shipping_address }}\r\n                    {% elif doc.address_display %}\r\n                        {{ doc.address_display }}\r\n                    {% elif doc.customer_address %}\r\n                        {{ doc.customer_address }}\r\n                    {% endif %}\r\n                </div>\r\n\r\n                {% if doc.contact_display %}\r\n                    <div class=\"contact-details\">\r\n                        {{ doc.contact_display }}\r\n                    </div>\r\n                {% endif %}\r\n\r\n                {% if doc.contact_mobile %}\r\n                    <div class=\"contact-details\">\r\n                        <strong>Mobile:</strong>\r\n                        {{ doc.contact_mobile }}\r\n                    </div>\r\n                {% endif %}\r\n\r\n                {% if doc.contact_email %}\r\n                    <div class=\"contact-details\">\r\n                        <strong>Email:</strong>\r\n                        {{ doc.contact_email }}\r\n                    </div>\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"delivery-info-section\">\r\n\r\n                <table class=\"delivery-details\">\r\n\r\n                    <tr>\r\n                        <td class=\"detail-label\">\r\n                            Delivery Date\r\n                        </td>\r\n\r\n                        <td class=\"detail-value\">\r\n                            {{ frappe.utils.formatdate(\r\n                                doc.posting_date,\r\n                                \"dd MMM yyyy\"\r\n                            ) }}\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <!--\r\n                    Optional Posting Time\r\n\r\n                    <tr>\r\n                        <td class=\"detail-label\">\r\n                            Delivery Time\r\n                        </td>\r\n\r\n                        <td class=\"detail-value\">\r\n                            {{ doc.posting_time or \"\" }}\r\n                        </td>\r\n                    </tr>\r\n                    -->\r\n\r\n\r\n                    <!--<tr>-->\r\n                    <!--    <td class=\"detail-label\">-->\r\n                    <!--        Challan Type :-->\r\n                    <!--    </td>-->\r\n\r\n                    <!--    <td class=\"detail-value\">-->\r\n                    <!--        {{ doc.custom_challan_type or \"Others\" }}-->\r\n                    <!--    </td>-->\r\n                    <!--</tr>-->\r\n\r\n\r\n                    {% if doc.po_no %}\r\n                        <tr>\r\n                            <td class=\"detail-label\">\r\n                                Customer P.O.#\r\n                            </td>\r\n\r\n                            <td class=\"detail-value\">\r\n                                {{ doc.po_no }}\r\n                            </td>\r\n                        </tr>\r\n                    {% endif %}\r\n\r\n\r\n                    {% if doc.lr_no %}\r\n                        <tr>\r\n                            <td class=\"detail-label\">\r\n                                L.R. No.\r\n                            </td>\r\n\r\n                            <td class=\"detail-value\">\r\n                                {{ doc.lr_no }}\r\n                            </td>\r\n                        </tr>\r\n                    {% endif %}\r\n\r\n\r\n                    {% if doc.transporter_name %}\r\n                        <tr>\r\n                            <td class=\"detail-label\">\r\n                                Transporter\r\n                            </td>\r\n\r\n                            <td class=\"detail-value\">\r\n                                {{ doc.transporter_name }}\r\n                            </td>\r\n                        </tr>\r\n                    {% endif %}\r\n\r\n\r\n                    <!--\r\n                    Optional Driver Name custom field\r\n\r\n                    {% if doc.custom_driver_name %}\r\n                        <tr>\r\n                            <td class=\"detail-label\">\r\n                                Driver Name\r\n                            </td>\r\n\r\n                            <td class=\"detail-value\">\r\n                                {{ doc.custom_driver_name }}\r\n                            </td>\r\n                        </tr>\r\n                    {% endif %}\r\n                    -->\r\n\r\n\r\n                    <!--\r\n                    Optional Vehicle Number\r\n\r\n                    {% if doc.vehicle_no %}\r\n                        <tr>\r\n                            <td class=\"detail-label\">\r\n                                Vehicle No.\r\n                            </td>\r\n\r\n                            <td class=\"detail-value\">\r\n                                {{ doc.vehicle_no }}\r\n                            </td>\r\n                        </tr>\r\n                    {% endif %}\r\n                    -->\r\n\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n\r\n    <!-- ==================================================\r\n         ITEM TABLE\r\n         ================================================== -->\r\n\r\n    <table class=\"item-table\">\r\n        <thead>\r\n            <tr>\r\n                <th class=\"col-number\">#</th>\r\n                <th class=\"col-image\"></th>\r\n                <th class=\"col-description\">Item &amp; Description</th>\r\n                <th class=\"col-qty\">Qty</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n\r\n                {% set master_item_image = frappe.db.get_value(\r\n                    \"Item\",\r\n                    item.item_code,\r\n                    \"image\"\r\n                ) %}\r\n\r\n                {% set display_image = item.image or master_item_image %}\r\n\r\n                <tr>\r\n                    <td class=\"col-number\">\r\n                        {{ loop.index }}\r\n                    </td>\r\n\r\n\r\n                    <td class=\"col-image\">\r\n                        {% if display_image %}\r\n                            <img\r\n                                src=\"{{ display_image }}\"\r\n                                class=\"item-image\"\r\n                                alt=\"{{ item.item_name or item.item_code }}\"\r\n                            >\r\n                        {% else %}\r\n                            <!--\r\n                            No image placeholder is currently hidden.\r\n\r\n                            To show a placeholder, remove the comment below.\r\n\r\n                            <div class=\"item-image-placeholder\">\r\n                                No Image\r\n                            </div>\r\n                            -->\r\n                        {% endif %}\r\n                    </td>\r\n\r\n\r\n                    <td class=\"col-description\">\r\n\r\n                        <div class=\"item-name\">\r\n                            {{ item.item_name or item.item_code }}\r\n                        </div>\r\n\r\n\r\n                        {% if item.item_code %}\r\n                            <div class=\"item-code\">\r\n                                {{ item.item_code }}\r\n                            </div>\r\n                        {% endif %}\r\n\r\n\r\n                        {% if item.description %}\r\n                            <div class=\"item-description\">\r\n                                {{ item.description }}\r\n                            </div>\r\n                        {% endif %}\r\n\r\n\r\n                        {% if item.serial_no %}\r\n                            <div class=\"item-reference\">\r\n                                Serial Number#:\r\n                                {{ item.serial_no | replace(\"\\n\", \", \") }}\r\n                            </div>\r\n                        {% endif %}\r\n\r\n\r\n                        {% if item.batch_no %}\r\n                            <div class=\"item-reference\">\r\n                                Batch#:\r\n                                {{ item.batch_no }}\r\n                            </div>\r\n                        {% endif %}\r\n\r\n\r\n                        <!--\r\n                        Optional Customer Item Code\r\n\r\n                        {% if item.customer_item_code %}\r\n                            <div class=\"item-reference\">\r\n                                Customer Item Code:\r\n                                {{ item.customer_item_code }}\r\n                            </div>\r\n                        {% endif %}\r\n                        -->\r\n\r\n\r\n                        <!--\r\n                        Optional Sales Order Reference\r\n\r\n                        {% if item.against_sales_order %}\r\n                            <div class=\"item-reference\">\r\n                                Sales Order:\r\n                                {{ item.against_sales_order }}\r\n                            </div>\r\n                        {% endif %}\r\n                        -->\r\n\r\n                    </td>\r\n\r\n\r\n                    <td class=\"col-qty\">\r\n                        <div class=\"quantity-value\">\r\n                            {{ frappe.utils.fmt_money(\r\n                                item.qty,\r\n                                precision=2\r\n                            ) }}\r\n                        </div>\r\n\r\n                        <div class=\"quantity-uom\">\r\n                            {{ item.uom or item.stock_uom }}\r\n                        </div>\r\n                    </td>\r\n                </tr>\r\n\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n\r\n    <!-- ==================================================\r\n         TOTAL ITEM COUNT\r\n         ================================================== -->\r\n\r\n    <div class=\"item-count\">\r\n        Items in Total {{ doc.items | length }}\r\n    </div>\r\n\r\n\r\n    <!-- ==================================================\r\n         REMARKS\r\n         Shows only when Delivery Note has remarks\r\n         ================================================== -->\r\n\r\n    {% if doc.remarks %}\r\n        <div class=\"remarks-section\">\r\n            <div class=\"remarks-title\">\r\n                Remarks\r\n            </div>\r\n\r\n            <div class=\"remarks-content\">\r\n                {{ doc.remarks }}\r\n            </div>\r\n        </div>\r\n    {% endif %}\r\n\r\n\r\n    <!--\r\n    Optional Terms and Conditions\r\n\r\n    {% if doc.terms %}\r\n        <div class=\"remarks-section\">\r\n            <div class=\"remarks-title\">\r\n                Terms & Conditions\r\n            </div>\r\n\r\n            <div class=\"remarks-content\">\r\n                {{ doc.terms }}\r\n            </div>\r\n        </div>\r\n    {% endif %}\r\n    -->\r\n\r\n\r\n    <!-- ==================================================\r\n         RECEIVER AND SIGNATURE SECTION\r\n         ================================================== -->\r\n\r\n    <div class=\"signature-section\">\r\n\r\n        <table class=\"signature-table\">\r\n            <tr>\r\n\r\n                <td>\r\n                    <div class=\"signature-field\">\r\n                        <span class=\"signature-label\">\r\n                            Date:\r\n                        </span>\r\n\r\n                        <span class=\"signature-line\"></span>\r\n                    </div>\r\n\r\n                    <div class=\"signature-field\">\r\n                        <span class=\"signature-label\">\r\n                            Signature:\r\n                        </span>\r\n\r\n                        <span class=\"signature-line\"></span>\r\n                    </div>\r\n                </td>\r\n\r\n\r\n                <td>\r\n                    <div class=\"signature-field\">\r\n                        <span class=\"signature-label\">\r\n                            Receiver's Name:\r\n                        </span>\r\n\r\n                        <span class=\"signature-line\"></span>\r\n                    </div>\r\n\r\n                    <div class=\"signature-field\">\r\n                        <span class=\"signature-label\">\r\n                            Mob/Tel No:\r\n                        </span>\r\n\r\n                        <span class=\"signature-line\"></span>\r\n                    </div>\r\n                </td>\r\n\r\n\r\n                <td class=\"company-stamp-cell\">\r\n\r\n                    <!--\r\n                    OPTION 1 \u2014 Display uploaded stamp image\r\n\r\n                    <img\r\n                        src=\"/private/files/arabscale_stamp.png\"\r\n                        class=\"stamp-image\"\r\n                        alt=\"Company Stamp\"\r\n                    >\r\n                    -->\r\n\r\n\r\n                    <!--\r\n                    OPTION 2 \u2014 Display employee signature\r\n\r\n                    {% if doc.custom_authorized_signature %}\r\n                        <img\r\n                            src=\"{{ doc.custom_authorized_signature }}\"\r\n                            class=\"stamp-image\"\r\n                            alt=\"Authorized Signature\"\r\n                        >\r\n                    {% endif %}\r\n                    -->\r\n\r\n\r\n                    <!-- Current active text -->\r\n                    <div class=\"stamp-label\">\r\n                        Company Stamp\r\n                    </