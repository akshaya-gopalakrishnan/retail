ARG ERPNEXT_IMAGE=frappe/erpnext:v15.108.3
FROM ${ERPNEXT_IMAGE}

LABEL it.celestial.retail.image="1"

USER root

COPY apps/retail/deployment/docker/retail-entrypoint.sh /usr/local/bin/retail-entrypoint.sh
RUN chmod 755 /usr/local/bin/retail-entrypoint.sh

COPY --chown=frappe:frappe apps/hrms /home/frappe/frappe-bench/apps/hrms
COPY --chown=frappe:frappe apps/retail /home/frappe/frappe-bench/apps/retail

USER frappe

RUN cd /home/frappe/frappe-bench \
	&& rm -rf apps/hrms/hrms/public/dist apps/retail/retail/public/dist \
	&& printf "frappe\nerpnext\nhrms\nretail\n" > sites/apps.txt \
	&& ./env/bin/pip install --no-cache-dir -e apps/hrms -e apps/retail \
	&& yarn --cwd apps/hrms install --frozen-lockfile --check-files \
	&& ./env/bin/python -c "import json, hrms, retail; from pathlib import Path; p=Path('sites/apps.json'); data=json.loads(p.read_text()); data.update({'hrms': {'resolution': {'commit_hash': None, 'branch': 'version-15'}, 'required': [], 'idx': 3, 'version': hrms.__version__}, 'retail': {'resolution': {'commit_hash': None, 'branch': 'main'}, 'required': [], 'idx': 4, 'version': retail.__version__}}); p.write_text(json.dumps(data, indent=4) + '\n')" \
	&& ln -sfn /home/frappe/frappe-bench/apps/hrms/hrms/public assets/hrms \
	&& ln -sfn /home/frappe/frappe-bench/apps/retail/retail/public assets/retail \
	&& bench build --production --apps hrms,retail \
	&& ./env/bin/python -m retail.build_asset_manifest

ENTRYPOINT ["/usr/local/bin/retail-entrypoint.sh"]
