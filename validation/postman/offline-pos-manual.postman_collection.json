{
  "info": {
    "name": "Offline POS \u2014 Manual Test \u2014 retail-test.localhost",
    "description": "Run requests ONE AT A TIME in numbered order. Creates test transactions. Uses Karama / counter01 / T01 / E-6, then counter02 / T02. Enter only test API credentials in the supplied environment. References stay fixed for retries. Day closing affects the branch/date; review its preview before submitting. Clear run_id only when starting a genuinely new test, never to retry a completed operation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// References and dates are created ONCE and kept for retries.",
          "if (!pm.collectionVariables.get(\"run_id\")) {",
          "  const local = new Date(Date.now() + 4 * 3600000).toISOString();",
          "  const day = local.slice(0, 10);",
          "  const id = String(Date.now());",
          "  pm.collectionVariables.set(\"run_id\", id);",
          "  pm.collectionVariables.set(\"business_date\", day);",
          "  pm.collectionVariables.set(\"opened_at\", local.slice(0, 19).replace(\"T\", \" \"));",
          "  pm.collectionVariables.set(\"sale_time\", local.slice(11, 19));",
          "  const later = new Date(Date.now() + 4 * 3600000 + 2000).toISOString();",
          "  pm.collectionVariables.set(\"return_date\", later.slice(0, 10));",
          "  pm.collectionVariables.set(\"return_time\", later.slice(11, 19));",
          "  [\"SHIFT\", \"CS\", \"SHIFTOPEN\", \"SALE\", \"CREDIT\", \"COLLECTION\", \"DEPOSIT\", \"CASHIN\", \"CASHOUT\", \"RETURN\", \"PAUSE\", \"CS2\", \"RESUME\", \"SHIFTCLOSE\", \"DAYCLOSE\"].forEach(type => {",
          "    pm.collectionVariables.set(type.toLowerCase() + \"_ref\", \"KAR-counter01-T01-\" + type + \"-\" + day.replace(/-/g, \"\") + \"-\" + id);",
          "  });",
          "  [\"CS2\", \"RESUME\", \"SHIFTCLOSE\"].forEach(type => {",
          "    const label = type === \"CS2\" ? \"CS\" : type;",
          "    pm.collectionVariables.set(type.toLowerCase() + \"_ref\", \"KAR-counter02-T02-\" + label + \"-\" + day.replace(/-/g, \"\") + \"-\" + id);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 \u2014 Check connection",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "retail-test.localhost"
          },
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/method/retail.api.pos_sync.health_check?branch=Karama&counter_code=counter01",
        "description": "Use the test site only. No records are created."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const result = pm.response.json().message;",
              "pm.test(\"Request reached ERP\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"ERP returned a reply\", () => pm.expect(result).to.be.an(\"object\"));",
              "pm.test(\"Counter is ready\", () => pm.expect(result.status).to.eql(\"OK\"));"
            ]
          }
        }
      ]
    },
