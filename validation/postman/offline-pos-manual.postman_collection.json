            "type": "text/javascript",
            "exec": [
              "const result = pm.response.json().message;",
              "pm.test(\"Request reached ERP\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"ERP returned a reply\", () => pm.expect(result).to.be.an(\"object\"));",
              "pm.test(\"ERP accepted the request\", () => pm.expect(result.status).to.eql(\"Success\"));",
              "pm.test(\"ERP returned all three mappings\", () => {",
              "  pm.expect(result.cashier_shift).to.match(/^PSH-[1-9][0-9]*$/);",
